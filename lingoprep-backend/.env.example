# LingoPrep Backend Environment Variables
# Copy this to .env and fill in your values.
#
# NOTE: this file is committed to git. Keep placeholders here only — real keys
# belong in .env, which is listed in .gitignore and never uploaded.

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
# Backend only: required for protected question reads and result writes.
# Leave out of NEXT_PUBLIC_* variables and all frontend configuration.
SUPABASE_SERVICE_ROLE_KEY=

# Backend-only stable random secret (32+ characters), identical on all workers.
# Required for private guest/IP quota keys and submission retry ownership.
RESOURCE_LIMIT_SECRET=
# Optional absolute executable override; otherwise use PATH or the bundled decoder.
# FFMPEG_BINARY=/path/to/ffmpeg

# Groq Cloud API (for Llama 3)
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Debug mode
DEBUG=true
