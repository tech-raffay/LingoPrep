# ===========================
# LingoPrep — Root .gitignore
# ===========================

# --- Node / Frontend ---
node_modules/
.next/
out/
.env.local
.env*.local
npm-debug.log*

# --- Python / Backend ---
venv/
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/

# --- Environment ---
.env

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo
*.sublime-*

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- Misc ---
*.log
coverage/
.vercel

# Design canvas editor artifact
.thumbnail

# Jupyter notebooks (coursework, not part of the app)
*.ipynb
.ipynb_checkpoints/

# Listening recordings in static/audio/*.mp3 are committed on purpose, so the
# deployed backend serves them without generating. Only temp files are ignored.
*.mp3.part
